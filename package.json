{
  "name": "shitpostman",
  "version": "1.0.0",
  "description": "A Frutiger Aero flavoured API client for the desktop.",
  "main": "./out/main/index.js",
  "author": "Bowie",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/bowvernon110391/shitpostman.git"
  },
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "start": "electron-vite preview",
    "build": "electron-vite build",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "package": "electron-vite build && electron-builder --win --config electron-builder.yml --publish never",
    "dist": "electron-vite build && electron-builder --publish never",
    "release": "electron-vite build && electron-builder --publish always"
  },
  "dependencies": {
    "axios": "^1.7.7",
    "electron-store": "^8.2.0",
    "follow-redirects": "^1.15.9"
  },
  "devDependencies": {
    "@types/node": "^20.14.10",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "electron": "^31.3.1",
    "electron-builder": "^24.13.3",
    "electron-vite": "^2.3.0",
    "lucide-react": "^0.427.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.5.4",
    "vite": "^5.4.2",
    "zustand": "^4.5.4"
  },
  "allowScripts": {
    "electron@31.7.7": true,
    "esbuild@0.21.5": true
  }
}
