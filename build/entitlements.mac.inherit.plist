<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
  <dict>
    <!--
      Inherited by the helper apps and frameworks nested inside the bundle
      (Renderer, GPU, Plugin, ...). They need the same Hardened Runtime
      exceptions as the main executable, so this file mirrors
      `entitlements.mac.plist`.

      Only read during code signing; ignored while the release is unsigned.
    -->
    <key>com.apple.security.cs.allow-jit</key>
    <true/>
    <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
    <true/>
  </dict>
</plist>
